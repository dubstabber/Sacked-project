    "level.1.description": {
      "pl": "Niewielkie biuro, w którym pracują nadal dwie osoby. Wyczucie czasu jest niezbędne.",
      "de": "Ein kleines Büro mit nur noch zwei Angestellten. Zur richtigen Zeit am richtigen Ort zu sein ist hier der Schlüssel zum Erfolg.",
      "file": "Level_00.txt"
    },
    "level.1.hint": {
      "pl": "Czy wiesz, że Twoi koledzy zawsze Cię zauważą, jeśli siejesz zniszczenie blisko nich? Nawet jeśli są odwróceni plecami.",
      "de": "Wusstest Du schon, dass Deine Ex-Kollegen Zerstörungen in ihrer unmittelbaren Nähe immer bemerken?",
      "file": "Level_00.txt"
    },
    "level.2.description": {
      "pl": "Zobacz, jak harują przy biurkach na prawo i lewo.",
      "de": "Zur Rechten wie zur Linken siehst Du sie an Ihren Plätzen schinden.",
      "file": "Level_01.txt"
    },
    "level.2.hint": {
      "pl": "Wiesz, że zapalniczka to podstawowe narzędzie zemsty?",
      "de": "Wusstest Du schon, dass ein Feuerzeug eines der wichtigsten Rachewerkzeuge ist?",
      "file": "Level_01.txt"
    },
    "level.3.description": {
      "pl": "Szef właśnie cię wywalił, ale teraz wyszedł z biura. Do dzieła!",
      "de": "Eben hat Dein Boss Dich noch gefeuert, jetzt ist er schon nicht mehr im Büro.  Kannst Du diesen Umstand nutzen?",
      "file": "Level_02.txt"
    },
    "level.3.hint": {
      "pl": "Czy wiesz, że do palenia potrzebujesz dwóch rzeczy?",
      "de": "Wusstest Du schon, dass zum Rauchen zwei Utensilien benötigt werden?",
      "file": "Level_02.txt"
    },
    "level.4.description": {
      "pl": "...i tak mało czasu! Mądrze go wykorzystaj!",
      "de": "... und so wenig Zeit.  Nutzen Du sollst sie weise!",
      "file": "Level_03.txt"
    },
    "level.4.hint": {
      "pl": "Wiesz, że możesz sprawdzić pole widzenia Twoich kolegów?",
      "de": "Wusstest Du schon, dass Du den Sichtkegel jedes Kollegen sichtbar machen kannst?",
      "file": "Level_03.txt"
    },
    "level.5.description": {
      "pl": "To biuro zawsze było dla ciebie za małe. Nadszedł czas na wielkie czyny.",
      "de": "In diesem Büro war es Dir sowieso schon immer zu eng.  Jetzt ist die Zeit für grosse Taten.",
      "file": "Level_04.txt"
    },
    "level.5.hint": {
      "pl": "Czy wiesz, że możesz cofnąć czynność, póki widzisz menu akcji? Jeśli już zaczniesz coś robić, nie możesz tego zatrzymać.",
      "de": "Wusstest Du schon, dass Aktionen im Auswahlfenster abgebrochen werden können?  Einmal gestartet, geht das nicht mehr.",
      "file": "Level_04.txt"
    },
    "level.6.description": {
      "pl": "...tak twoi byli koledzy zaharowują się na śmierć w biurze. Wstrząśnij nimi trochę.",
      "de": "...sitzen Deine Ex-Kollegen bei der Arbeit.  Los!  Scheuch sie mal ordentlich auf.",
      "file": "Level_05.txt"
    },
    "level.6.hint": {
      "pl": "Wiesz, że niektóre czynności będą niedostępne, jeśli wykonasz najpierw inne?",
      "de": "Wusstest Du schon, dass manche Aktionen andere sperren?",
      "file": "Level_05.txt"
    },
    "level.7.description": {
      "pl": "Zniszcz, czego nie zniszczył dotąd żaden człowiek.",
      "de": "Zerstöre, wo noch nie zuvor ein Mensch zerstört hat.",
      "file": "Level_06.txt"
    },
    "level.7.hint": {
      "pl": "Wiesz, że przy pomocy faksu możesz przesłać ściśle tajne dokumenty całemu światu?",
      "de": "Wusstest Du schon, dass mit einem Faxgerät auch sensible Firmeninformationen in die Welt verschickt werden können?",
      "file": "Level_06.txt"
    },
    "level.8.description": {
      "pl": "Nie rozumiesz? My też nie mogliśmy w to uwierzyć.",
      "de": "Das verstehst Du nicht?  Wir hätten es auch nicht geglaubt.",
      "file": "Level_07.txt"
    },
    "level.8.hint": {
      "pl": "Wiesz, że sejf można otworzyć?",
      "de": "Wusstest Du schon, dass Du den Safe auch öffnen kannst?",
      "file": "Level_07.txt"
    },
    "level.9.description": {
      "pl": "...niezbędne mogą okazać się niezwykłe metody.",
      "de": "...das tu den anderen, das tut gut!",
      "file": "Level_08.txt"
    },
    "level.9.hint": {
      "pl": "Czy wiesz, że niektóre przedmioty lubią spać z rybkami?",
      "de": "Wusstest Du schon, dass bestimmte Gegenstände im Aquarium nicht nur die Fische ärgern?",
      "file": "Level_08.txt"
    },
    "level.10.description": {
      "pl": "Byli koledzy są uzależnieni od kawy i przesiadują w kuchni. Masz spore pole do manewru!",
      "de": "Diese Ex-Kollegen stehen ja andauernd in der Küche.  Kannst Du das für Deine Zwecke nutzen?",
      "file": "Level_09.txt"
    },
    "level.10.hint": {
      "pl": "Czy wiesz, że istnieje związek między kuchenkami mikrofalowymi i systemem klimatyzacji?",
      "de": "Wusstest Du schon, dass es eine direkte Verbindung zwischen Klimaanlagen und Mikrowellen gibt?",
      "file": "Level_09.txt"
    },
    "level.11.description": {
      "pl": "Skorzystaj z nich w toalecie.",
      "de": "Draufgeschissen!",
      "file": "Level_10.txt"
    },
    "level.11.hint": {
      "pl": "Czy wiesz, że liczy się nie tylko uczynek, ale także miejsce?",
      "de": "Wusstest Du schon, dass Aktionen an verschiedenen Orten auch unterschiedlich gewertet werden können?",
      "file": "Level_10.txt"
    },
    "level.12.description": {
      "pl": "Małe, przytulne pokoje i tłum ludzi - to tworzy szczególną atmosferę, prawda?",
      "de": "Enge Räume und viele Ex-Kollegen erzeugen einen ganz besonderen Flair.",
      "file": "Level_11.txt"
    },
    "level.12.hint": {
      "pl": "Czy wiesz, że ludzie, którzy stracą stanowisko pracy, mogą zacząć włóczyć się po okolicy?",
      "de": "Wusstest Du schon, dass Ex-Kollegen sich nach Verlust ihres Arbeitsplatzes dem Vergnügen hingeben und durch das Büro streifen?",
      "file": "Level_11.txt"
    },
    "level.13.description": {
      "pl": "Każdy musi dbać o swój pokój. Dopóki nie usłyszy zewu natury...",
      "de": "Hier muss jeder Angestellte auf sein eigenes Zimmer aufpassen.  Aber sie müssen ja auch mal was essen.",
      "file": "Level_12.txt"
    },
    "level.13.hint": {
      "pl": "Wiesz, że wkurzając kolegów zyskasz więcej punktów?",
      "de": "Wusstest Du schon, dass der Zorn Deiner Ex-Kollegen auf Dauer Punkte bringt?",
      "file": "Level_12.txt"
    },
    "level.14.description": {
      "pl": "Znajdziesz tu szeroki wybór napojów. A że w przyrodzie nic nie ginie, musisz... Hehe, już łapiesz.",
      "de": "Und nicht nur dort findet man ausreichend zu trinken.  Aber wohin, wenn man mal muss?  Hehe ... erraten.",
      "file": "Level_13.txt"
    },
    "level.14.hint": {
      "pl": "Wiesz, że mydło jest wielokrotnego użytku?",
      "de": "Wusstest Du schon, dass Seife sich mehrmals benutzen lässt?",
      "file": "Level_13.txt"
    },
    "level.15.description": {
      "pl": "To zapach zemsty!",
      "de": "Es riecht nach Rache!",
      "file": "Level_14.txt"
    },
    "level.15.hint": {
      "pl": "Wiesz, że możesz pozamykać kolegów w toalecie?",
      "de": "Wusstest Du schon, dass man Ex-Kollegen auf der Toilette einsperren kann?",
      "file": "Level_14.txt"
    },
    "level.16.description": {
      "pl": "Ma więc ważniejsze sprawy na głowie, a nikt nie pilnuje jego gabinetu.",
      "de": "Wer passt eigentlich auf das Bosszimmer auf, wenn dieser mal nicht da ist?",
      "file": "Level_15.txt"
    },
    "level.16.hint": {
      "pl": "Wiesz, że uniwersalny klucz otwiera przed Tobą nowe możliwości?",
      "de": "Wusstest Du schon, dass der Generalschlüssel neue Aktionsmöglichkeiten erschliesst?",
      "file": "Level_15.txt"
    },
    "level.17.description": {
      "pl": "Pokaż szefowi co do niego czujesz",
      "de": "Taten sagen mehr als 1000 Worte.  Zeige Deinem Boss, welch tiefe Gefühle Du für ihn hegst.",
      "file": "Level_16.txt"
    },
    "level.17.hint": {
      "pl": "Wiesz, że przemoc nie jest jedynym rozwiązaniem?",
      "de": "Wusstest Du schon, dass Gewalt keine Lösung ist?",
      "file": "Level_16.txt"
    },
    "level.18.description": {
      "pl": "Może by tak opróżnić choć raz środkowe biuro?",
      "de": "Wäre es schön, wenn das mittlere Büro mal leer wäre...",
      "file": "Level_17.txt"
    },
    "level.18.hint": {
      "pl": "Wiesz, że korki mogą bardzo namieszać? Chociaż ciężko je znaleźć.",
      "de": "Wusstest Du schon, dass Waschbeckenstöpsel schwer zu finden sind?",
      "file": "Level_17.txt"
    },
    "level.19.description": {
      "pl": "Uważnie obejrzyj okolicę. Większość przedmiotów to już i tak złom, który należy posortować.",
      "de": "Aber mustere auch den Rest genau.  Da gibt es reichlich gültige Objekte zum ausmustern.",
      "file": "Level_18.txt"
    },
    "level.19.hint": {
      "pl": "Wiesz, że Twoi byli koledzy są bardzo otwarci, co do swoich zamiarów? Wystarczy obserwować dymki nad ich głowami.",
      "de": "Wusstest Du schon, dass Du an den Gedankenblasen über Deinen Ex-Kollegen ihre nächste Absicht ahnen kannst?",
      "file": "Level_18.txt"
    },
    "level.20.description": {
      "pl": "Szybki, wszechstronny, dynamiczny - to cechy dobrego urzędnika. Nigdy nie jest za późno, by je w sobie odnaleźć - nawet ostatniego dnia w pracy.",
      "de": "Schnell, flexibel, dynamisch... manche Fähigkeiten wollen am letzten Tag noch entdeckt werden.",
      "file": "Level_19.txt"
    },
    "level.20.hint": {
      "pl": "Wiesz, że torby i mapy skrywają wiele ciekawych rzeczy?",
      "de": "Wusstest Du schon, dass sich in Koffern und Taschen interessante Privatgegenstände finden lassen?",
      "file": "Level_19.txt"
    },
    "level.21.description": {
      "pl": "Długie korytarze, drogie dywany, wielka i czysta kuchnia, atrakcyjny personel i bogate wyposażenie, które czeka żeby je zniszczyć.",
      "de": "Lange, blau leuchtende Flure, herrlich weiss glänzende Küchen und ein ganzes Sortiment an zu zerstörenden Gegenständen. Buchen Sie noch heute ...",
      "file": "Level_20.txt"
    },
    "level.21.hint": {
      "pl": "Wiesz, że problemy można rozwiązywać także werbalnie?",
      "de": "Wusstest Du schon, dass man Probleme auch verbal lösen kann?",
      "file": "Level_20.txt"
    },
